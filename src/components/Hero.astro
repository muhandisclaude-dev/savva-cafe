---
import Wordmark from './Wordmark.astro';
import { t } from '../i18n';
import { isOpenNow } from '../data/venue';
import { photos } from '../data/photos';

const openAtBuild = isOpenNow();
const hero = photos.heroNight;
---

<header class="hero" id="top">
  <figure class="hero-photo" data-photo-lift>
    <img
      src={`/photos/${hero.file}`}
      width={hero.width}
      height={hero.height}
      alt={hero.alt.ar}
      data-alt-ar={hero.alt.ar}
      data-alt-en={hero.alt.en}
      fetchpriority="high"
    />
    <div class="hero-scrim" aria-hidden="true"></div>
    <div class="dapple-glow" data-dapple aria-hidden="true" style="--dapple-src:url('/brand/dapple-a.png')"></div>
  </figure>

  <div class="hero-body">
    <div class="hero-mark reveal">
      <Wordmark class="hero-mark-svg" />
      <span class="hero-coffee">{t.brandCoffee.en}</span>
    </div>

    <div class="hero-say">
      <p class="kicker reveal reveal-delay-1">
        <span data-lang="ar">{t.heroLead.ar}</span>
        <span data-lang="en">{t.heroLead.en}</span>
      </p>

      <p class="hero-status reveal reveal-delay-2" data-status aria-live="polite">
        <span class="dot" data-open={String(openAtBuild)} aria-hidden="true"></span>
        <span data-status-word>
          <span data-lang="ar">{openAtBuild ? t.openNow.ar : t.closedNow.ar}</span>
          <span data-lang="en">{openAtBuild ? t.openNow.en : t.closedNow.en}</span>
        </span>
        <span class="hero-status-sep" aria-hidden="true">·</span>
        <span data-status-hours>
          <span data-lang="ar">{openAtBuild ? t.closesAt.ar : t.opensAt.ar}</span>
          <span data-lang="en">{openAtBuild ? t.closesAt.en : t.opensAt.en}</span>
        </span>
      </p>

      <a href="#menu" class="btn btn-solid hero-cta reveal reveal-delay-3">
        <span data-lang="ar">{t.navMenu.ar}</span>
        <span data-lang="en">{t.navMenu.en}</span>
      </a>
    </div>
  </div>

  <a href="#story" class="scroll-cue" aria-hidden="true" tabindex="-1">
    <span class="scroll-line"></span>
    <span class="kicker">
      <span data-lang="ar">{t.scrollCue.ar}</span>
      <span data-lang="en">{t.scrollCue.en}</span>
    </span>
  </a>
</header>

<style>
  .hero {
    position: relative;
    min-block-size: 100dvh;
    display: grid;
    grid-template-rows: 1fr auto;
    overflow: hidden;
    isolation: isolate;
    background: var(--color-ink);
  }

  .hero-photo {
    position: absolute;
    inset: 0;
    margin: 0;
    overflow: hidden;
  }
  .hero-photo img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: center 38%;
  }

  /* Фото не лежит на фоне — оно тонет в темноте у краёв, особенно снизу,
     где текст и лента текста должны читаться поверх него */
  .hero-scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, var(--color-ink) 2%, color-mix(in srgb, var(--color-ink) 55%, transparent) 32%, transparent 62%),
      linear-gradient(to bottom, color-mix(in srgb, var(--color-ink) 75%, transparent) 0%, transparent 30%),
      linear-gradient(to right, color-mix(in srgb, var(--color-ink) 55%, transparent) 0%, transparent 45%);
  }

  .hero-body {
    position: relative;
    z-index: 1;
    grid-row: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(1.6rem, 4vh, 2.75rem);
    padding: clamp(1.5rem, 5vw, 3.5rem) clamp(1.25rem, 4vw, 3rem) clamp(3.5rem, 9vh, 6rem);
    text-align: center;
  }

  .hero-mark { display: flex; flex-direction: column; align-items: center; gap: 0.6rem; }
  :global(.hero-mark-svg) {
    inline-size: min(52vw, 13rem);
    block-size: auto;
    color: var(--color-sand);
    filter: drop-shadow(0 2px 24px color-mix(in srgb, var(--color-ink) 70%, transparent));
  }
  .hero-coffee {
    font-family: var(--font-latin);
    text-transform: uppercase;
    letter-spacing: 0.4em;
    text-indent: 0.4em;
    font-size: clamp(0.62rem, 0.55rem + 0.4vw, 0.8rem);
    color: var(--color-sage-bright);
  }

  .hero-say { display: flex; flex-direction: column; align-items: center; gap: 1.3rem; }
  .hero-say .kicker { justify-content: center; }
  .hero-say .kicker::before { display: none; }

  .hero-status {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-latin-expanded);
    font-size: clamp(1.5rem, 1.1rem + 2.4vw, 2.9rem);
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.15;
    color: var(--color-sand-warm);
  }
  html[dir='rtl'] .hero-status { font-family: var(--font-arabic-display); font-weight: 500; }

  .dot {
    inline-size: 0.5rem;
    block-size: 0.5rem;
    border-radius: 50%;
    background: var(--color-sand);
    opacity: 0.5;
    flex: none;
  }
  .dot[data-open='true'] {
    background: var(--color-glow);
    opacity: 1;
    box-shadow: 0 0 0.6rem color-mix(in srgb, var(--color-glow) 80%, transparent);
    animation: pulse 3.2s ease-in-out infinite;
  }
  @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.45; } }

  .hero-status-sep { opacity: 0.45; font-family: var(--font-latin); font-weight: 400; }

  .hero-cta { padding-inline: clamp(2.2rem, 5vw, 3.5rem); letter-spacing: 0.04em; }

  .scroll-cue {
    position: absolute;
    z-index: 1;
    inset-block-end: 1.5rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.7rem;
  }
  .scroll-line {
    inline-size: 1px;
    block-size: 2.4rem;
    background: linear-gradient(to bottom, var(--sand-line), transparent);
    animation: scroll-hint 2.4s ease-in-out infinite;
  }
  @keyframes scroll-hint {
    0%, 100% { transform: scaleY(1); opacity: 0.7; }
    50% { transform: scaleY(0.6); opacity: 1; }
  }

  @media (max-width: 640px) {
    .hero-body { padding-block-end: clamp(3rem, 12vh, 4.5rem); }
    :global(.hero-mark-svg) { inline-size: min(56vw, 11rem); }
    .scroll-cue { display: none; }
  }
</style>
