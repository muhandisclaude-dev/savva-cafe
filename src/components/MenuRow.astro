---
import Riyal from './Riyal.astro';
import { t } from '../i18n';
import type { MenuItem } from '../data/menu';

interface Props {
  item: MenuItem;
}
const { item } = Astro.props;

const priceLabel = Array.isArray(item.price) ? `${item.price[0]}–${item.price[1]}` : String(item.price);
const hasOptions = (item.options?.length ?? 0) > 0;
const searchKey = `${item.name.ar} ${item.name.en} ${item.originalEn ?? ''}`.toLowerCase();
---

<li class="row" data-item={item.id} data-search={searchKey}>
  <div class="row-name">
    <span class="n-ar">{item.name.ar}</span>
    <span class="n-en">{item.name.en}</span>
    {
      item.signature && (
        <span class="n-sig">
          <span data-lang="ar">{t.signature.ar}</span>
          <span data-lang="en">{t.signature.en}</span>
        </span>
      )
    }
    {
      item.note && (
        <span class="n-note">
          <span data-lang="ar">{item.note.ar}</span>
          <span data-lang="en">{item.note.en}</span>
        </span>
      )
    }
  </div>

  <div class="row-tail">
    <div class="row-price">
      <span class="p-num tnum"><Riyal />{priceLabel}</span>
      {
        item.cals != null && (
          <span class="p-cals">
            <span class="tnum">{item.cals}</span>
            <span data-lang="ar"> {t.cals.ar}</span>
            <span data-lang="en"> {t.cals.en}</span>
          </span>
        )
      }
    </div>

    <button
      type="button"
      class="row-fav"
      data-fav={item.id}
      aria-pressed="false"
      data-label-ar={t.favourite.ar}
      data-label-en={t.favourite.en}
      aria-label={t.favourite.en}
    >
      <span class="fav-mark" aria-hidden="true"></span>
    </button>

    <button
      type="button"
      class="row-add"
      data-add={item.id}
      data-options={hasOptions ? 'true' : 'false'}
      data-label-ar={`${t.addTo.ar} — ${item.name.ar}`}
      data-label-en={`${t.addTo.en} — ${item.name.en}`}
      aria-label={`${t.addTo.en} — ${item.name.en}`}
    >
      <span aria-hidden="true">+</span>
    </button>
  </div>
</li>

<style>
  .row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.25rem;
    padding-block: 1.05rem;
    border-block-end: 1px solid var(--sand-line-soft);
    transition: background-color 0.35s var(--ease-drift);
  }
  .row:last-child { border-block-end: 0; }
  .row[hidden] { display: none; }

  /* Подсветка тянется на поля, чтобы строка читалась как целая, а не как коробка */
  .row:hover {
    background: color-mix(in srgb, var(--color-sand) 6%, transparent);
    box-shadow: 0 0 0 0.9rem color-mix(in srgb, var(--color-sand) 6%, transparent);
  }
  @media (hover: none) { .row:hover { background: none; box-shadow: none; } }

  /* ── Название: текущий язык крупнее, второй под ним ──────── */
  .row-name {
    display: flex;
    flex-direction: column;
    gap: 0.12rem;
    min-inline-size: 0;
  }

  .n-ar, .n-en { display: block; }

  .n-en {
    font-family: var(--font-latin);
    text-transform: uppercase;
    letter-spacing: 0.11em;
  }

  html[lang='ar'] .n-ar,
  html[lang='en'] .n-en {
    font-size: clamp(1.02rem, 0.95rem + 0.35vw, 1.22rem);
    font-weight: 400;
    color: var(--color-sand);
    line-height: 1.3;
  }

  html[lang='ar'] .n-en,
  html[lang='en'] .n-ar {
    font-size: 0.78rem;
    color: var(--sand-faint);
    line-height: 1.4;
  }

  html[lang='en'] .n-en { order: -1; }

  .n-sig {
    margin-block-start: 0.3rem;
    font-family: var(--font-latin);
    font-size: 0.62rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--sand-dim);
    border: 1px solid var(--sand-line);
    padding: 0.16rem 0.5rem;
    align-self: flex-start;
  }
  html[dir='rtl'] .n-sig { letter-spacing: 0; text-transform: none; font-family: var(--font-arabic); }

  .n-note {
    margin-block-start: 0.35rem;
    max-inline-size: 34ch;
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--sand-dim);
  }

  /* ── Цена и действия ─────────────────────────────────────── */
  .row-tail {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex: none;
  }

  .row-price {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    line-height: 1.15;
    min-inline-size: 4.5rem;
  }
  html[dir='rtl'] .row-price { align-items: flex-start; }

  .p-num {
    display: inline-flex;
    align-items: center;
    gap: 0.18em;
    font-family: var(--font-latin);
    font-size: clamp(1.05rem, 0.98rem + 0.35vw, 1.25rem);
    font-weight: 400;
    color: var(--color-sand);
  }

  .p-cals {
    font-family: var(--font-latin);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sand-faint);
  }
  html[dir='rtl'] .p-cals { letter-spacing: 0; text-transform: none; font-family: var(--font-arabic); }

  /* ── Избранное: не сердце, а их же веточка ───────────────── */
  .row-fav {
    inline-size: 2.4rem;
    block-size: 2.4rem;
    display: grid;
    place-items: center;
    border: 1px solid transparent;
    color: var(--sand-faint);
    transition: color 0.3s var(--ease-drift), border-color 0.3s var(--ease-drift);
  }
  .row-fav:hover { color: var(--sand-dim); border-color: var(--sand-line-soft); }
  .row-fav[aria-pressed='true'] { color: var(--color-sand); }

  .fav-mark {
    inline-size: 1.35rem;
    block-size: 1.35rem;
    background-color: currentColor;
    -webkit-mask: url('/brand/sprig.png') no-repeat center / contain;
    mask: url('/brand/sprig.png') no-repeat center / contain;
    transition: transform 0.4s var(--ease-drift);
  }
  .row-fav[aria-pressed='true'] .fav-mark { transform: scale(1.14) rotate(-6deg); }

  /* ── Добавить ────────────────────────────────────────────── */
  .row-add {
    inline-size: 2.2rem;
    block-size: 2.2rem;
    display: grid;
    place-items: center;
    border: 1px solid var(--sand-line);
    font-size: 1.15rem;
    font-weight: 300;
    line-height: 1;
    color: var(--color-sand);
    transition: background-color 0.3s var(--ease-drift), border-color 0.3s var(--ease-drift), transform 0.3s var(--ease-drift);
  }
  .row-add:hover { background: color-mix(in srgb, var(--color-sand) 12%, transparent); border-color: var(--sand-dim); }
  .row-add:active { transform: scale(0.92); }
  .row-add.just-added { background: var(--color-sand); color: var(--color-sage-dark); border-color: var(--color-sand); }

  @media (max-width: 560px) {
    .row { gap: 0.75rem; padding-block: 0.95rem; }
    .row:hover { background: none; box-shadow: none; }
    .row-price { min-inline-size: 3.6rem; }
    .row-fav { display: none; }
    .n-note { max-inline-size: none; }
    /* Палец, а не курсор: 35 px было мало для попадания за столиком */
    .row-add { inline-size: 2.75rem; block-size: 2.75rem; }
  }
</style>
