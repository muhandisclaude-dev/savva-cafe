---
import { t } from '../i18n';
import { venue } from '../data/venue';

// Точные координаты заведения не подтверждены, поэтому карта ищет по тому же
// адресу, что стоит в карточке Google. Ссылка «Маршрут» ведёт на их запись напрямую.
const mapEmbed = `https://maps.google.com/maps?q=${encodeURIComponent(
  'Savva, Zubairah Al Roumiah, Bir Uthman, Madinah 42331',
)}&hl=ar&z=16&output=embed`;
---

<section class="visit" id="visit" aria-labelledby="visit-title">
  <div class="visit-inner">
    <div class="visit-say">
      <p class="kicker">
        <span data-lang="ar">{t.visitTitle.ar}</span>
        <span data-lang="en">{t.visitTitle.en}</span>
      </p>

      <h2 class="visit-title" id="visit-title">
        <span data-lang="ar">{venue.address.ar}</span>
        <span data-lang="en">{venue.address.en}</span>
      </h2>

      <dl class="visit-facts">
        <dt>
          <span data-lang="ar">{t.visitHours.ar}</span>
          <span data-lang="en">{t.visitHours.en}</span>
        </dt>
        <dd>
          <span data-lang="ar">{t.visitDaily.ar}</span>
          <span data-lang="en">{t.visitDaily.en}</span>
        </dd>

        <dt>
          <span data-lang="ar">{t.visitPhone.ar}</span>
          <span data-lang="en">{t.visitPhone.en}</span>
        </dt>
        <dd><a href={`tel:${venue.phone}`} class="visit-link tnum">{venue.phoneDisplay}</a></dd>

        <dt>
          <span data-lang="ar">{t.visitPlusCode.ar}</span>
          <span data-lang="en">{t.visitPlusCode.en}</span>
        </dt>
        <dd class="tnum">{venue.plusCode}</dd>
      </dl>

      <div class="visit-actions">
        <a class="btn btn-solid" href={venue.maps} target="_blank" rel="noopener">
          <span data-lang="ar">{t.visitRoute.ar}</span>
          <span data-lang="en">{t.visitRoute.en}</span>
        </a>
        <a class="btn" href={`tel:${venue.phone}`}>
          <span data-lang="ar">{t.visitCall.ar}</span>
          <span data-lang="en">{t.visitCall.en}</span>
        </a>
      </div>
    </div>

    <div class="visit-map">
      <iframe
        src={mapEmbed}
        title="SAVVA on the map"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen></iframe>
    </div>
  </div>
</section>

<style>
  .visit {
    padding-block: clamp(3.5rem, 9vh, 6.5rem);
    padding-inline: clamp(1.1rem, 4vw, 3rem);
    background: var(--color-sage-deep);
    border-block-start: 1px solid var(--sand-line);
  }

  .visit-inner {
    max-inline-size: 74rem;
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(1.75rem, 5vw, 4rem);
    align-items: center;
  }

  .visit-say { display: flex; flex-direction: column; gap: 1rem; }

  .visit-title {
    margin: 0;
    max-inline-size: 22ch;
    font-size: clamp(1.3rem, 1.05rem + 1.4vw, 1.95rem);
    font-weight: 300;
    line-height: 1.4;
  }

  .visit-facts {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.5rem 1.5rem;
    margin: 0.6rem 0 0;
    padding-block-start: 1.2rem;
    border-block-start: 1px solid var(--sand-line);
    align-items: baseline;
  }
  .visit-facts dt { font-size: 0.78rem; color: var(--sand-faint); }
  .visit-facts dd { margin: 0; font-size: 0.95rem; }

  .visit-link { border-block-end: 1px solid var(--sand-line); transition: border-color 0.3s var(--ease-drift); }
  .visit-link:hover { border-block-end-color: var(--color-sand); }

  .visit-actions { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-block-start: 0.8rem; }
  .visit-actions .btn { font-size: 0.88rem; padding-block: 0.75rem; }

  .visit-map {
    border: 1px solid var(--sand-line);
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }
  .visit-map iframe {
    inline-size: 100%;
    block-size: 100%;
    border: 0;
    display: block;
    /* Карта Google приходит в своей палитре — приглушаем, чтобы она села в лист */
    filter: grayscale(0.55) sepia(0.28) saturate(0.75) brightness(0.92) contrast(0.95);
  }

  @media (max-width: 860px) {
    .visit-inner { grid-template-columns: 1fr; }
    .visit-map { aspect-ratio: 3 / 2; }
  }
</style>
