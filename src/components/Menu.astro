---
import MenuCard from './MenuCard.astro';
import { t } from '../i18n';
import { sections } from '../data/menu';
---

<section class="menu" id="menu" aria-labelledby="menu-title">
  <div class="menu-head">
    <p class="kicker">
      <span data-lang="ar">القائمة</span>
      <span data-lang="en">The menu</span>
    </p>
    <h2 class="sr-only" id="menu-title">{t.menuTitle.en}</h2>

    <div class="menu-search">
      <label class="sr-only" for="menu-q" data-label-ar={t.searchLabel.ar} data-label-en={t.searchLabel.en}>
        {t.searchLabel.en}
      </label>
      <input
        id="menu-q"
        type="search"
        class="field search-field"
        autocomplete="off"
        data-ph-ar={t.searchPlaceholder.ar}
        data-ph-en={t.searchPlaceholder.en}
        placeholder={t.searchPlaceholder.ar}
      />
    </div>

    <div class="menu-tabs" role="tablist" data-menu-tabs>
      <button type="button" class="tab" data-tab="all" aria-selected="true">
        <span data-lang="ar">الكل</span>
        <span data-lang="en">All</span>
      </button>
      {
        sections.map((s) => (
          <button type="button" class="tab" data-tab={s.id} aria-selected="false">
            <span data-lang="ar">{s.title.ar}</span>
            <span data-lang="en">{s.title.en}</span>
          </button>
        ))
      }
    </div>
  </div>

  <p class="menu-empty" data-empty hidden>
    <strong>
      <span data-lang="ar">{t.nothingFound.ar}</span>
      <span data-lang="en">{t.nothingFound.en}</span>
    </strong>
    <span class="menu-empty-hint">
      <span data-lang="ar">{t.nothingFoundHint.ar}</span>
      <span data-lang="en">{t.nothingFoundHint.en}</span>
    </span>
  </p>

  {
    sections.map((section) => (
      <div class="course" id={`s-${section.id}`} data-course={section.id}>
        <div class="course-head reveal">
          <h3 class="h-display course-title">
            <span data-lang="ar">{section.title.ar}</span>
            <span data-lang="en">{section.title.en}</span>
          </h3>
        </div>

        <ul class="course-grid" role="list">
          {section.items.map((item) => (
            <MenuCard item={item} />
          ))}
        </ul>
      </div>
    ))
  }
</section>

<style>
  .menu {
    position: relative;
    background: var(--color-ink);
    padding-block: clamp(4rem, 9vh, 7rem) clamp(3rem, 7vh, 5rem);
    padding-inline: clamp(1.1rem, 4vw, 3rem);
  }

  .menu-head {
    max-inline-size: 74rem;
    margin-inline: auto;
    margin-block-end: clamp(2.5rem, 6vh, 4rem);
    display: flex;
    flex-direction: column;
    gap: 1.3rem;
  }

  .menu-search { max-inline-size: 24rem; }
  .search-field { background: transparent; border-inline: 0; border-block-start: 0; padding-inline: 0; }

  .menu-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .tab {
    padding: 0.55rem 1.1rem;
    border: 1px solid var(--sand-line);
    font-size: 0.85rem;
    color: var(--sand-dim);
    transition: background-color 0.3s var(--ease-drift), border-color 0.3s var(--ease-drift), color 0.3s var(--ease-drift);
  }
  .tab:hover { color: var(--color-sand); border-color: var(--sand-dim); }
  .tab[aria-selected='true'] { background: var(--color-glow); color: var(--color-ink); border-color: var(--color-glow); }

  .menu-empty {
    max-inline-size: 74rem;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding-block: 2rem;
  }
  .menu-empty strong { font-weight: 500; font-size: 1.1rem; }
  .menu-empty-hint { color: var(--sand-dim); font-size: 0.9rem; }

  .course {
    max-inline-size: 74rem;
    margin-inline: auto;
    padding-block-end: clamp(3rem, 7vh, 5rem);
  }
  .course[hidden] { display: none; }

  .course-head {
    position: sticky;
    inset-block-start: calc(var(--rail-h) + 1rem);
    z-index: 2;
    padding-block: 0.6rem;
    margin-block-end: 1.3rem;
    background: color-mix(in srgb, var(--color-ink) 88%, transparent);
    backdrop-filter: blur(6px);
  }
  .course-title {
    margin: 0;
    font-size: clamp(1.4rem, 1.1rem + 1.2vw, 2.1rem);
    color: var(--color-sand-warm);
  }

  .course-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(15rem, 100%), 1fr));
    gap: clamp(0.9rem, 2vw, 1.5rem);
  }

  @media (max-width: 640px) {
    .course-head { inset-block-start: var(--rail-h); }
    .course-grid { grid-template-columns: repeat(2, 1fr); gap: 0.75rem; }
  }
</style>
