---
import { t } from '../i18n';
import { withBase } from '../lib/asset';
import { photos } from '../data/photos';

const beats = [
  {
    id: 'morning',
    photo: photos.barCounter,
    kicker: { ar: 'صباحًا', en: 'Morning' },
    title: { ar: 'يبدأ الطحن', en: 'The grind starts' },
    body: {
      ar: 'إسبريسو، كورتادو، كابتشينو، قهوة مقطّرة. اختر قهوة اليوم أو ابدأ بالكلاسيكيات.',
      en: 'Espresso, cortado, cappuccino, hand-poured filter. Start with the coffee of the day, or a classic.',
    },
  },
  {
    id: 'noon',
    photo: photos.tableDesserts,
    kicker: { ar: 'ظهرًا', en: 'Midday' },
    title: { ar: 'استراحة حلوة', en: 'A sweet pause' },
    body: {
      ar: 'مديني كوكيز، تشيز كيك بلوبيري، كيكة الشوكلت. على الطاولة أو عند النافذة.',
      en: 'Madini cookies, blueberry cheesecake, chocolate cake. At the table, or by the window.',
    },
  },
  {
    id: 'night',
    photo: photos.nightTerrace,
    kicker: { ar: 'ليلًا', en: 'Night' },
    title: { ar: 'حتى الثانية صباحًا', en: 'Until two in the morning' },
    body: {
      ar: 'التراس مضاء، والمشروبات الباردة تستمر. ساڤا لا تنام مبكرًا.',
      en: 'The terrace stays lit, the iced drinks keep coming. Savva doesn’t close early.',
    },
  },
] as const;
---

<section class="story" id="story" aria-labelledby="story-title">
  <h2 class="sr-only" id="story-title">
    <span data-lang="ar">يوم في ساڤا</span>
    <span data-lang="en">A day in SAVVA</span>
  </h2>

  {
    beats.map((beat, i) => (
      <div class="beat" id={`beat-${beat.id}`}>
        <figure class="beat-photo" data-photo-lift>
          <img
            src={withBase(`/photos/${beat.photo.file}`)}
            width={beat.photo.width}
            height={beat.photo.height}
            alt={beat.photo.alt.ar}
            data-alt-ar={beat.photo.alt.ar}
            data-alt-en={beat.photo.alt.en}
            loading={i === 0 ? 'eager' : 'lazy'}
            decoding="async"
          />
          <div class="beat-scrim" aria-hidden="true" />
        </figure>

        <div class="beat-say">
          <p class="kicker beat-kicker">
            <span data-lang="ar">{beat.kicker.ar}</span>
            <span data-lang="en">{beat.kicker.en}</span>
          </p>
          <h3 class="h-display beat-title">
            <span data-lang="ar">{beat.title.ar}</span>
            <span data-lang="en">{beat.title.en}</span>
          </h3>
          <p class="beat-body">
            <span data-lang="ar">{beat.body.ar}</span>
            <span data-lang="en">{beat.body.en}</span>
          </p>
        </div>
      </div>
    ))
  }
</section>

<style>
  .story { background: var(--color-ink); }

  .beat {
    position: relative;
    min-block-size: 88vh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }

  .beat-photo {
    position: absolute;
    inset: 0;
    margin: 0;
  }
  .beat-photo img { inline-size: 100%; block-size: 100%; object-fit: cover; }
  .beat-scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, var(--color-ink) 6%, color-mix(in srgb, var(--color-ink) 45%, transparent) 42%, transparent 75%),
      linear-gradient(to right, color-mix(in srgb, var(--color-ink) 40%, transparent), transparent 55%);
  }

  .beat-say {
    position: relative;
    z-index: 1;
    padding: clamp(2rem, 7vw, 5rem);
    max-inline-size: 36rem;
  }

  .beat-kicker { margin: 0 0 0.9rem; }
  .beat-kicker::before { display: none; }

  .beat-title {
    margin: 0 0 0.85rem;
    font-size: clamp(2.1rem, 1.5rem + 3vw, 4rem);
    color: var(--color-sand-warm);
  }

  .beat-body {
    margin: 0;
    max-inline-size: 34ch;
    font-size: clamp(0.98rem, 0.9rem + 0.3vw, 1.1rem);
    line-height: 1.65;
    color: var(--sand-dim);
  }

  @media (max-width: 640px) {
    .beat { min-block-size: 78vh; }
    .beat-say { padding: 1.75rem; }
  }
</style>
