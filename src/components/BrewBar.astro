---
import Riyal from './Riyal.astro';
import { t } from '../i18n';
import { sections } from '../data/menu';

const brew = sections.find((s) => s.id === 'brew')!;
---

<section class="brew" id="brew" aria-labelledby="brew-title">
  <div class="dapple brew-dapple" aria-hidden="true"></div>

  <div class="brew-inner">
    <div class="brew-say">
      <p class="kicker">
        <span data-lang="ar">{t.brewTitle.ar}</span>
        <span data-lang="en">{t.brewTitle.en}</span>
      </p>

      <h2 class="brew-title" id="brew-title">
        <span data-lang="ar">{t.brewLead.ar}</span>
        <span data-lang="en">{t.brewLead.en}</span>
      </h2>

      <ul class="brew-list" role="list">
        {
          brew.items.map((item) => (
            <li class="brew-item">
              <div class="brew-item-name">
                <span class="bi-ar">{item.name.ar}</span>
                <span class="bi-en">{item.name.en}</span>
              </div>
              {item.note && (
                <p class="brew-item-note">
                  <span data-lang="ar">{item.note.ar}</span>
                  <span data-lang="en">{item.note.en}</span>
                </p>
              )}
              <div class="brew-item-foot">
                <span class="brew-price tnum">
                  <Riyal />
                  {Array.isArray(item.price) ? `${item.price[0]}–${item.price[1]}` : item.price}
                </span>
                <button
                  type="button"
                  class="btn brew-add"
                  data-add={item.id}
                  data-options="true"
                  data-label-ar={`${t.addTo.ar} — ${item.name.ar}`}
                  data-label-en={`${t.addTo.en} — ${item.name.en}`}
                >
                  <span data-lang="ar">{t.add.ar}</span>
                  <span data-lang="en">{t.add.en}</span>
                </button>
              </div>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="brew-art" aria-hidden="true">
      <span class="brew-branch"></span>
    </div>
  </div>
</section>

<style>
  .brew {
    position: relative;
    overflow: hidden;
    background: var(--color-sage-deep);
    border-block: 1px solid var(--sand-line);
    padding-block: clamp(3.5rem, 9vh, 6.5rem);
    padding-inline: clamp(1.1rem, 4vw, 3rem);
  }

  .brew-dapple {
    --dapple-src: url('/brand/dapple-b.png');
    opacity: 0.7;
    -webkit-mask-image: var(--dapple-src), linear-gradient(to bottom, #000 40%, transparent 92%);
    mask-image: var(--dapple-src), linear-gradient(to bottom, #000 40%, transparent 92%);
    -webkit-mask-size: cover, 100% 100%;
    mask-size: cover, 100% 100%;
    -webkit-mask-composite: source-in;
    mask-composite: intersect;
    animation: brew-drift 120s var(--ease-drift) infinite alternate;
  }
  @keyframes brew-drift {
    from { transform: translate3d(2%, 0, 0) scale(1.1); }
    to   { transform: translate3d(-3%, -2%, 0) scale(1.18); }
  }

  .brew-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.62fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    max-inline-size: 74rem;
    margin-inline: auto;
  }

  .brew-say { display: flex; flex-direction: column; gap: 1.1rem; }

  .brew-title {
    margin: 0;
    max-inline-size: 26ch;
    font-size: clamp(1.35rem, 1.05rem + 1.5vw, 2.1rem);
    font-weight: 300;
    line-height: 1.35;
  }

  .brew-list {
    list-style: none;
    margin: 0.8rem 0 0;
    padding: 0;
    display: grid;
    gap: 1.1rem;
  }

  .brew-item {
    border: 1px solid var(--sand-line);
    padding: clamp(1rem, 2.5vw, 1.4rem);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .brew-item-name { display: flex; flex-direction: column; gap: 0.1rem; }
  .bi-en { font-family: var(--font-latin); text-transform: uppercase; letter-spacing: 0.14em; }

  html[lang='ar'] .bi-ar,
  html[lang='en'] .bi-en { font-size: 1.15rem; color: var(--color-sand); }
  html[lang='ar'] .bi-en,
  html[lang='en'] .bi-ar { font-size: 0.75rem; color: var(--sand-faint); }
  html[lang='en'] .bi-en { order: -1; }

  .brew-item-note { margin: 0; font-size: 0.88rem; line-height: 1.55; color: var(--sand-dim); max-inline-size: 40ch; }

  .brew-item-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-block-start: 0.35rem;
  }

  .brew-price {
    display: inline-flex;
    align-items: center;
    gap: 0.2em;
    font-family: var(--font-latin);
    font-size: 1.3rem;
  }

  .brew-add { padding: 0.6rem 1.4rem; font-size: 0.85rem; }

  .brew-art { display: grid; place-items: center; }
  .brew-branch {
    inline-size: 100%;
    max-inline-size: 20rem;
    aspect-ratio: 903 / 1407;
    background-color: var(--color-sand);
    opacity: 0.34;
    -webkit-mask: url('/brand/branch.png') no-repeat center / contain;
    mask: url('/brand/branch.png') no-repeat center / contain;
    transform: scaleX(-1);
  }

  @media (max-width: 860px) {
    .brew-inner { grid-template-columns: 1fr; }
    .brew-art { display: none; }
  }
</style>
