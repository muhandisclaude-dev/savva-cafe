---
import Riyal from './Riyal.astro';
import { t } from '../i18n';
import { withBase } from '../lib/asset';
import { sections } from '../data/menu';
import { photos } from '../data/photos';

const brew = sections.find((s) => s.id === 'brew')!;
const photo = photos.barCounter;
---

<section class="brew" id="brew" aria-labelledby="brew-title">
  <figure class="brew-photo" data-photo-lift>
    <img
      src={withBase(`/photos/${photo.file}`)}
      width={photo.width}
      height={photo.height}
      alt={photo.alt.ar}
      data-alt-ar={photo.alt.ar}
      data-alt-en={photo.alt.en}
      loading="lazy"
      decoding="async"
    />
  </figure>

  <div class="brew-say">
    <p class="kicker">
      <span data-lang="ar">{t.brewTitle.ar}</span>
      <span data-lang="en">{t.brewTitle.en}</span>
    </p>

    <h2 class="h-display brew-title" id="brew-title">
      <span data-lang="ar">{t.brewLead.ar}</span>
      <span data-lang="en">{t.brewLead.en}</span>
    </h2>

    <ul class="brew-list" role="list">
      {
        brew.items.map((item) => (
          <li class="brew-item">
            <div class="brew-item-name">
              <span class="bi-ar">{item.name.ar}</span>
              <span class="bi-en">{item.name.en}</span>
            </div>
            {item.note && (
              <p class="brew-item-note">
                <span data-lang="ar">{item.note.ar}</span>
                <span data-lang="en">{item.note.en}</span>
              </p>
            )}
            <div class="brew-item-foot">
              <span class="brew-price tnum">
                <Riyal />
                {Array.isArray(item.price) ? `${item.price[0]}–${item.price[1]}` : item.price}
              </span>
              <button
                type="button"
                class="btn brew-add"
                data-add={item.id}
                data-options="true"
                data-label-ar={`${t.addTo.ar} — ${item.name.ar}`}
                data-label-en={`${t.addTo.en} — ${item.name.en}`}
              >
                <span data-lang="ar">{t.add.ar}</span>
                <span data-lang="en">{t.add.en}</span>
              </button>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .brew {
    position: relative;
    background: var(--color-ink-2);
    border-block: 1px solid var(--sand-line-soft);
    padding-block: clamp(3.5rem, 9vh, 6.5rem);
    padding-inline: clamp(1.1rem, 4vw, 3rem);
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    max-inline-size: 78rem;
    margin-inline: auto;
  }

  .brew-photo {
    margin: 0;
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }
  .brew-photo img { inline-size: 100%; block-size: 100%; object-fit: cover; }

  .brew-say { display: flex; flex-direction: column; gap: 1.1rem; }

  .brew-title {
    margin: 0;
    max-inline-size: 22ch;
    font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.4rem);
    color: var(--color-sand-warm);
  }

  .brew-list { list-style: none; margin: 0.8rem 0 0; padding: 0; display: grid; gap: 1.1rem; }

  .brew-item { border: 1px solid var(--sand-line-soft); padding: clamp(1rem, 2.5vw, 1.4rem); display: flex; flex-direction: column; gap: 0.5rem; }

  .brew-item-name { display: flex; flex-direction: column; gap: 0.1rem; }
  .bi-en { font-family: var(--font-latin); text-transform: uppercase; letter-spacing: 0.12em; }
  html[lang='ar'] .bi-ar, html[lang='en'] .bi-en { font-size: 1.1rem; color: var(--color-sand-warm); }
  html[lang='ar'] .bi-en, html[lang='en'] .bi-ar { font-size: 0.75rem; color: var(--sand-faint); }
  html[lang='en'] .bi-en { order: -1; }

  .brew-item-note { margin: 0; font-size: 0.88rem; line-height: 1.55; color: var(--sand-dim); max-inline-size: 42ch; }

  .brew-item-foot { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-block-start: 0.35rem; }
  .brew-price { display: inline-flex; align-items: center; gap: 0.2em; font-family: var(--font-latin); font-size: 1.3rem; color: var(--color-glow); }
  .brew-add { padding: 0.6rem 1.4rem; font-size: 0.85rem; }

  @media (max-width: 860px) {
    .brew { grid-template-columns: 1fr; }
    .brew-photo { aspect-ratio: 16 / 10; }
  }
</style>
