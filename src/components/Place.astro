---
import { t } from '../i18n';
import { venue } from '../data/venue';
import { photos, roomGallery } from '../data/photos';

const gallery = roomGallery.map((key) => photos[key]);
---

<section class="room" id="room" aria-labelledby="room-title">
  <div class="room-head">
    <p class="kicker">
      <span data-lang="ar">المكان</span>
      <span data-lang="en">The room</span>
    </p>
    <h2 class="h-display room-title" id="room-title">
      <span data-lang="ar">{t.placeLead.ar}</span>
      <span data-lang="en">{t.placeLead.en}</span>
    </h2>

    <dl class="room-facts">
      <div>
        <dt class="tnum" data-counter={venue.seats}>0</dt>
        <dd>
          <span data-lang="ar">مقعدًا</span>
          <span data-lang="en">seats</span>
        </dd>
      </div>
      <div>
        <dt class="tnum" data-counter={venue.rating} data-counter-decimals="1">0.0</dt>
        <dd>
          <span data-lang="ar">{venue.reviews} {t.reviewsWord.ar}</span>
          <span data-lang="en">from {venue.reviews} {t.reviewsWord.en}</span>
        </dd>
      </div>
      <div>
        <dt class="tnum">02:00</dt>
        <dd>
          <span data-lang="ar">حتى الفجر تقريبًا</span>
          <span data-lang="en">we stay open late</span>
        </dd>
      </div>
    </dl>
  </div>

  <ul class="room-grid" role="list">
    {
      gallery.map((p, i) => (
        <li class:list={['room-cell', i === 0 && 'room-cell-wide']}>
          <figure data-photo-lift>
            <img
              src={`/photos/${p.file}`}
              width={p.width}
              height={p.height}
              alt={p.alt.ar}
              data-alt-ar={p.alt.ar}
              data-alt-en={p.alt.en}
              loading="lazy"
              decoding="async"
            />
          </figure>
        </li>
      ))
    }
  </ul>

  <p class="room-credit">
    <span data-lang="ar">الصور من حساب المقهى وخرائط Google</span>
    <span data-lang="en">Photos from the café’s own account and Google Maps</span>
  </p>
</section>

<style>
  .room {
    background: var(--color-ink);
    padding-block: clamp(3.5rem, 9vh, 6.5rem);
    padding-inline: clamp(1.1rem, 4vw, 3rem);
  }

  .room-head { max-inline-size: 74rem; margin-inline: auto; display: flex; flex-direction: column; gap: 1rem; }

  .room-title {
    margin: 0;
    max-inline-size: 30ch;
    font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.4rem);
    color: var(--color-sand-warm);
  }

  .room-facts {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(1.5rem, 5vw, 4rem);
    margin: 1.4rem 0 0;
    padding-block-start: 1.4rem;
    border-block-start: 1px solid var(--sand-line-soft);
  }
  .room-facts > div { display: flex; flex-direction: column; gap: 0.15rem; }
  .room-facts dt {
    font-family: var(--font-latin-expanded);
    font-size: clamp(2rem, 1.5rem + 2vw, 3.2rem);
    font-weight: 700;
    line-height: 1;
    color: var(--color-glow);
  }
  .room-facts dd { margin: 0; font-size: 0.8rem; color: var(--sand-dim); }

  .room-grid {
    list-style: none;
    margin: clamp(2rem, 5vh, 3.5rem) auto 0;
    padding: 0;
    max-inline-size: 74rem;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.6rem;
  }
  .room-cell { margin: 0; overflow: hidden; }
  .room-cell-wide { grid-column: span 2; grid-row: span 2; }
  .room-cell figure { margin: 0; inline-size: 100%; block-size: 100%; }
  .room-cell img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    aspect-ratio: 1;
    display: block;
    transition: transform 0.7s var(--ease-out);
  }
  .room-cell-wide img { aspect-ratio: 1; }
  .room-cell:hover img { transform: scale(1.04); }

  .room-credit {
    max-inline-size: 74rem;
    margin: 1rem auto 0;
    font-size: 0.72rem;
    color: var(--sand-faint);
  }

  @media (max-width: 720px) {
    .room-grid { grid-template-columns: repeat(2, 1fr); }
    .room-cell-wide { grid-column: span 2; grid-row: span 1; }
  }
</style>
